---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { categoryNames, categorySlug, site } from '../../../config/site';
import { getPublishedPosts } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const used = new Set(posts.map((post) => post.data.category));
  return categoryNames
    .filter((name) => used.has(name))
    .map((name) => ({
      params: { category: categorySlug(name) },
      props: { name },
    }));
}

interface Props {
  name: (typeof categoryNames)[number];
}

const { name } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => post.data.category === name);
const title = `${name} | Blog | ${site.name}`;
const description = `Notas de ${name}, escritas por Martín Galmarino.`;
---

<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="wrap">
      <h1>{name}</h1>
      <p class="lead"><a href="/blog/">Volver al blog</a></p>
      <div class="post-list">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
