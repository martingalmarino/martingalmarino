---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import PostCard from '../../../components/PostCard.astro';
import { site } from '../../../config/site';
import { getPublishedPosts, PAGE_SIZE, type Post } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const total = Math.ceil(posts.length / PAGE_SIZE);
  return Array.from({ length: Math.max(0, total - 1) }, (_, index) => {
    const page = index + 2;
    const start = (page - 1) * PAGE_SIZE;
    return {
      params: { page: String(page) },
      props: {
        page,
        total,
        posts: posts.slice(start, start + PAGE_SIZE),
      },
    };
  });
}

interface Props {
  page: number;
  total: number;
  posts: Post[];
}

const { page, total, posts } = Astro.props;
const title = `Blog, página ${page.toLocaleString('es-AR')} | ${site.name}`;
const description = 'Notas sobre SEO, GEO y AEO para empresas.';
---

<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Blog</h1>
      <div class="post-list">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <Pagination page={page} total={total} base="/blog/" />
    </div>
  </section>
</BaseLayout>
