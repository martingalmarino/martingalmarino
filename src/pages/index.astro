---
import { Picture } from 'astro:assets';
import portrait from '../assets/martin-galmarino.png';
import displayFont from '../assets/fonts/instrument-serif-latin-400.woff2?url';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchTabs from '../components/SearchTabs.astro';
import PostCard from '../components/PostCard.astro';
import Proof from '../components/Proof.astro';
import { guides, services, site } from '../config/site';
import { audiences, faqPlainText, faqs, steps } from '../data/home';
import { getPublishedPosts } from '../lib/blog';
import { faqPage } from '../lib/schema';
import { absoluteUrl } from '../config/site';

const posts = (await getPublishedPosts()).slice(0, 3);
const title = `${site.name} | ${site.tagline}`;
const canonical = absoluteUrl('/');
const faqGraph = faqPage(
  canonical,
  faqs.map((item) => ({ question: item.question, answer: faqPlainText(item) })),
);
---

<BaseLayout title={title} description={site.description} extraGraph={[faqGraph]}>
  <link slot="head" rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
  <div class="home">
  <section class="wrap hero">
    <div>
      <p class="eyebrow">Martín Galmarino</p>
      <h1>Tu empresa, visible en todos los lugares donde hoy se busca</h1>
      <p class="lead">
        Soy Martín. Desde 2007 trabajo la visibilidad de empresas que no tienen un equipo interno. Hoy eso también es aparecer cuando alguien le pregunta a una IA.
      </p>
      <div class="actions">
        <a class="button button--primary button--lg" href="/diagnostico/">Pedí tu diagnóstico</a>
        <a class="button button--ghost button--lg" href="/guia/">Entendé qué cambió</a>
      </div>
    </div>
    <figure class="hero-photo">
      <div class="portrait-frame">
        <Picture
          src={portrait}
          alt="Espacio reservado para la foto de Martín Galmarino"
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 960px) 38rem, 100vw"
          layout="constrained"
          class="portrait"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </figure>
  </section>

  <section class="facts-wrap" aria-label="Recorrido">
    <ul class="facts">
      <li>
        <strong>Desde 2007</strong>
        <span>En buscadores</span>
      </li>
      <li>
        <strong>Desde 2018</strong>
        <span>Docente en Fundación Graduados</span>
      </li>
      <li>
        <strong>Una nota por día</strong>
        <span>El blog sale así, de a una</span>
      </li>
    </ul>
  </section>

  <section class="section band" aria-labelledby="asi-se-busca">
    <div class="wrap">
      <h2 id="asi-se-busca">Así se busca hoy</h2>
      <p class="intro">
        La misma necesidad puede terminar en una lista, en un resumen o en un chat. El ejemplo es genérico: no es un cliente.
      </p>
      <SearchTabs />
    </div>
  </section>

  <section class="section" aria-labelledby="dato">
    <div class="wrap">
      <h2 id="dato">El dato que incomoda</h2>
      <p class="stat">45,5%</p>
      <p class="stat-copy">de los adultos en Argentina usa IA generativa para fines personales.</p>
      <p class="note">
        Fuente:
        <a
          href="https://www.utdt.edu/nota_prensa.php?id_item_menu=25279&id_nota_prensa=23080"
          rel="noopener noreferrer"
        >
          CEPE-UTDT y Fundar, encuesta nacional, agosto-septiembre 2025
          <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
        </a>.
      </p>
    </div>
  </section>

  <section class="section band" aria-labelledby="tres-formas">
    <div class="wrap">
      <h2 id="tres-formas">Tres formas de ser visible</h2>
      <div class="cards">
        {
          services.map((item) => (
            <a class="card" href={item.href}>
              <h3>{item.name}</h3>
              <p>{item.line}</p>
              <span class="card__go">Ver {item.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band-blue">
    <div class="wrap cta">
      <div>
        <h2>¿Vemos cómo aparece tu empresa?</h2>
        <p class="intro">El diagnóstico es gratuito y el informe es corto.</p>
      </div>
      <a class="button button--primary button--lg" href="/diagnostico/">Pedí tu diagnóstico</a>
    </div>
  </section>

  <section class="section" aria-labelledby="como-trabajo">
    <div class="wrap">
      <h2 id="como-trabajo">Cómo trabajo</h2>
      <p class="intro">
        El recorrido es el mismo si tenés una pyme, varias sucursales o un e-commerce. Cambia la escala, no el orden.
      </p>
      <ul class="chips">
        {audiences.map((item) => <li>{item}</li>)}
      </ul>
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <span>{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section band" aria-labelledby="quien">
    <div class="wrap person">
      <div>
        <h2 id="quien">Quién está detrás</h2>
        <p>
          Hace 19 años que trabajo con buscadores y, desde 2018, doy clases en Fundación Graduados.
        </p>
        <p>
          Acompaño a empresas en transformación digital que no tienen un equipo interno para esto.
        </p>
        <p><a href="/martin-galmarino/">Conocé mi recorrido</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="recursos">
    <div class="wrap">
      <h2 id="recursos">Para entender qué cambió</h2>
      <p class="intro">Tres lecturas cortas, en lenguaje de empresa. Después, si hace falta, vemos tu caso.</p>
      <div class="resources">
        {
          guides.map((item, index) => (
            <a class="resource" href={item.href}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.name}</h3>
              <p>{item.line}</p>
              <span class="card__go">Leer</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Proof />

  {
    posts.length > 0 && (
      <section class="section" aria-labelledby="notas">
        <div class="wrap">
          <h2 id="notas">Últimas notas</h2>
          <div class="post-list">
            {posts.map((post) => (
              <PostCard post={post} level={3} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="preguntas">
    <div class="wrap">
      <h2 id="preguntas">Preguntas frecuentes</h2>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>
                {item.answer}
                {item.sourceUrl && item.sourceLabel && (
                  <>
                    {' '}
                    Fuente:{' '}
                    <a href={item.sourceUrl} rel="noopener noreferrer">
                      {item.sourceLabel}
                      <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
                    </a>
                    .
                  </>
                )}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band-blue">
    <div class="wrap cta">
      <div>
        <h2>Pedí tu diagnóstico</h2>
        <p class="intro">
          Revisamos cómo aparece tu empresa en Google y qué responden ChatGPT, Gemini y Perplexity sobre el rubro.
        </p>
      </div>
      <a class="button button--primary button--lg" href="/diagnostico/">Pedí tu diagnóstico</a>
    </div>
  </section>
  </div>
</BaseLayout>
