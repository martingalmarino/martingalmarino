---
import { Picture } from 'astro:assets';
import portrait from '../assets/martin-galmarino-bn.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ChatMock from '../components/ChatMock.astro';
import ChannelRadar from '../components/ChannelRadar.astro';
import SearchTabs from '../components/SearchTabs.astro';
import StatCard from '../components/StatCard.astro';
import RankingBars from '../components/RankingBars.astro';
import Checklist from '../components/Checklist.astro';
import Timeline from '../components/Timeline.astro';
import ReportPreview from '../components/ReportPreview.astro';
import FaqList from '../components/FaqList.astro';
import PostCard from '../components/PostCard.astro';
import Proof from '../components/Proof.astro';
import { homeGuides, faqPlainText, faqs, stats } from '../data/home';
import { site } from '../config/site';
import { getPublishedPosts } from '../lib/blog';
import { faqPage } from '../lib/schema';
import { absoluteUrl } from '../config/site';

const posts = (await getPublishedPosts()).slice(0, 3);
const title = 'Martín Galmarino | SEO, GEO y AEO para empresas';
const description = site.description;
const faqGraph = faqPage(
  absoluteUrl('/'),
  faqs.map((item) => ({ question: item.question, answer: faqPlainText(item) })),
);
---

<BaseLayout title={title} description={description} extraGraph={[faqGraph]}>
  <div class="v2">
    <section class="v2-hero tex-dots" id="bloque-hero">
      <div class="glow" aria-hidden="true"></div>
      <div class="wrap v2-hero__copy">
        <p class="eyebrow">
          <b>SEO · GEO · AEO</b>
          <span>Martín Galmarino · para empresas</span>
        </p>
        <h1>
          Tus clientes ya le preguntan a la IA.
          <span class="t2">¿Te nombra a vos o a otro?</span>
        </h1>
        <p class="lead">
          Tu empresa, visible en todos los lugares donde hoy se busca: Google, sus resúmenes con IA, ChatGPT, Gemini y
          Perplexity. Te muestro qué responden sobre tu rubro y qué cambiar primero.
        </p>
        <div class="ctas">
          <a class="button button--primary" href="/diagnostico/">
            Quiero ver cómo me ve la IA
            <svg aria-hidden="true"><use href="#i-arrow"></use></svg>
          </a>
          <a class="button button--ghost" href="#autoprueba">Hacé la prueba en 2 minutos</a>
        </div>
        <p class="micro"><span>Gratis y sin compromiso</span></p>
      </div>
      <div class="wrap stage">
        <ChatMock />
        <ChannelRadar />
        <p class="cap">Ejemplo ilustrativo con datos ficticios: es lo que revisa el diagnóstico.</p>
      </div>
    </section>

    <section class="strip tex-grid" id="bloque-trayectoria" aria-label="Trayectoria">
      <ul class="wrap track">
        <li><b>19 años</b><span>en buscadores, desde 2007</span></li>
        <li><b>Desde 2010</b><span>trabajando en SEO</span></li>
        <li><b>Desde 2015</b><span>co-founder y director de proyectos en buscadores en Onmarc</span></li>
        <li><b>Docente</b><span>fui docente de SEO, Google Ads y Analytics</span></li>
      </ul>
    </section>

    <section class="band-white" id="asi-se-busca">
      <div class="wrap">
        <h2>Antes te buscaban. Hoy te comparan, y vos no estás en la conversación.</h2>
        <p class="lead">La misma pregunta termina hoy en cinco lugares distintos, y en cada uno se gana de otra forma.</p>
        <p class="intro">
          Una sola pregunta, cinco pantallas. Tocá cada pestaña y fijate qué significa «ganar» ahí. Ejemplo ilustrativo:
          no es un cliente.
        </p>
        <SearchTabs />
      </div>
    </section>

    <section class="band-cream tex-dots" id="datos">
      <div class="wrap">
        <h2>Casi 1 de cada 2 adultos en Argentina ya usa IA.</h2>
        <p class="lead">No es una moda de nicho: es un hábito que ya tienen tus clientes.</p>
        <div class="stat-grid">
          {stats.map((item) => <StatCard figure={item.figure} text={item.text} sources={item.sources} />)}
        </div>
      </div>
    </section>

    <section class="band-lav" id="quien-gana">
      <div class="wrap">
        <h2>En cada respuesta de la IA gana una empresa. ¿Sos vos?</h2>
        <p class="lead">Saber quién se lleva hoy esas recomendaciones es el primer paso para disputarlas.</p>
        <p class="intro">
          Le hicimos la misma pregunta a la IA 10 veces, en distintas herramientas. Ejemplo ilustrativo: las empresas y
          los números no son reales.
        </p>
        <RankingBars />
        <p class="prose-note">
          ¿Por qué gana A? En parte, por lo que dice su sitio. Pero también por lo que otros dicen de esa empresa. Según
          McKinsey, el sitio propio de una marca suele ser apenas entre el 5% y el 10% de las fuentes que usa la
          búsqueda con IA. <span>Análisis sobre EE.UU.</span>
          <a
            href="https://www.mckinsey.com/capabilities/growth-marketing-and-sales/our-insights/new-front-door-to-the-internet-winning-in-the-age-of-ai-search"
            target="_blank"
            rel="noopener noreferrer">McKinsey, «New front door to the internet», 16/10/2025</a
          >
        </p>
        <p class="remate">Cada pregunta que tu empresa no responde la responde un competidor.</p>
        <div class="ctas ctas--start">
          <a class="button button--primary" href="/diagnostico/">Quiero saber si me nombran</a>
        </div>
        <p class="micro micro--start"><span>Gratis y sin compromiso</span></p>
      </div>
    </section>

    <section class="band-white" id="autoprueba">
      <div class="wrap">
        <h2>5 señales de que tu empresa es invisible para la IA</h2>
        <p class="lead">Probalo en 2 minutos, sin pedirle nada a nadie.</p>
        <Checklist />
        <div class="ctas ctas--start">
          <a class="button button--primary" href="/diagnostico/">Quiero ver cómo me ve la IA</a>
        </div>
        <p class="micro micro--start"><span>Gratis y sin compromiso</span></p>
      </div>
    </section>

    <section class="band-cream" id="tres-formas">
      <div class="wrap">
        <h2>Tres lugares donde te pueden elegir. Un mismo trabajo de fondo.</h2>
        <p class="lead">No necesitás entender las siglas: necesitás saber dónde estás perdiendo.</p>
        <div class="trio">
          <article class="offer">
            <figure class="ex">
              <figcaption class="ilus">Ejemplo ilustrativo</figcaption>
              <div class="ex-hit">
                <span class="ex-pos">2</span>
                <div>
                  <span class="ex-url">empresa-a.com.ar</span>
                  <strong>Mantenimiento industrial en Córdoba | Empresa A</strong>
                  <p>Servicio para plantas de la zona. Pedí una visita técnica.</p>
                </div>
              </div>
            </figure>
            <h3>Que te encuentren en Google</h3>
            <p><b>Qué ganás:</b> aparecer cuando buscan lo que vendés, y darle a la IA una fuente clara sobre tu empresa.</p>
            <p><b>Señal de que lo necesitás:</b> no aparecés cuando buscan tu servicio y tu ciudad, ni en Google Maps.</p>
            <a href="/servicios/seo/">Ver SEO</a>
          </article>
          <article class="offer">
            <figure class="ex">
              <figcaption class="ilus">Ejemplo ilustrativo</figcaption>
              <p class="ex-bubble me">¿Qué empresa me recomendás en Córdoba?</p>
              <p class="ex-bubble">Estas son algunas opciones:</p>
              <ol class="ex-names">
                <li><b>Empresa A</b> · trabaja con pymes de la zona</li>
                <li><b>Empresa B</b> · tiene reseñas publicadas</li>
              </ol>
            </figure>
            <h3>Que la IA te nombre, y bien</h3>
            <p><b>Qué ganás:</b> estar entre las empresas que nombran ChatGPT, Gemini o Perplexity, con una descripción correcta.</p>
            <p><b>Señal de que lo necesitás:</b> la IA nombra a otros, o dice algo equivocado de vos.</p>
            <a href="/servicios/geo/">Ver GEO</a>
          </article>
          <article class="offer">
            <figure class="ex">
              <figcaption class="ilus">Ejemplo ilustrativo</figcaption>
              <div class="ex-ai">
                <b>Respuesta</b>
                <p>En Córdoba, el mantenimiento industrial para plantas lo publica Empresa A en su sitio.</p>
                <span class="ex-url">empresa-a.com.ar</span>
              </div>
              <div class="ex-hit is-dim">
                <span class="ex-pos">3</span>
                <div>
                  <span class="ex-url">otra-opcion.example</span>
                  <strong>Otra empresa del rubro</strong>
                  <p>Queda debajo del recuadro.</p>
                </div>
              </div>
            </figure>
            <h3>Que tu respuesta sea la que se lee</h3>
            <p><b>Qué ganás:</b> que la explicación que aparece arriba, en el recuadro o en el resumen, salga de tu sitio.</p>
            <p><b>Señal de que lo necesitás:</b> las dudas típicas de tu rubro las responde el sitio de otro.</p>
            <a href="/servicios/aeo/">Ver AEO</a>
          </article>
        </div>
        <p class="base">Los tres frentes se apoyan en lo mismo: un sitio que diga con claridad qué hacés, para quién y dónde.</p>
      </div>
    </section>

    <section class="band-violet" id="bloque-cta-medio">
      <div class="wrap">
        <h2>¿Querés saber qué responde hoy ChatGPT sobre tu rubro?</h2>
        <p class="lead">
          Pruebo 10 preguntas reales de tu rubro en Google, ChatGPT, Gemini y Perplexity. En hasta 5 días hábiles tenés
          el informe.
        </p>
        <div class="ctas ctas--start">
          <a class="button button--light" href="/diagnostico/">Quiero ver cómo me ve la IA</a>
        </div>
        <p class="micro micro--start"><span>Gratis y sin compromiso</span></p>
      </div>
    </section>

    <section class="band-white" id="como-trabajo">
      <div class="wrap">
        <h2>Cuatro pasos. Cada uno termina en algo que podés ver.</h2>
        <p class="lead">Sabés qué recibís, cuándo y cómo se mide.</p>
        <Timeline />
      </div>
    </section>

    <section class="band-night tex-grid" id="tu-diagnostico">
      <div class="wrap split">
        <div>
          <h2>Así se ve tu diagnóstico: lo que la IA dice hoy de tu empresa, sin vueltas.</h2>
          <p class="lead">Antes de invertir un peso, sabés dónde estás parado.</p>
          <p class="intro">Un PDF corto, que se lee en 10 minutos. Tiene seis partes.</p>
          <div class="ctas ctas--start">
            <a class="button button--primary" href="/diagnostico/">Quiero mi diagnóstico</a>
          </div>
          <p class="micro micro--start"><span>Gratis y sin compromiso</span></p>
        </div>
        <ReportPreview />
      </div>
    </section>

    <section class="band-cream" id="quien">
      <div class="wrap who">
        <div class="who-photo">
          <Picture
            src={portrait}
            alt="Martín Galmarino sonriendo, con remera negra, sobre una pared de madera clara"
            widths={[480, 720, 960]}
            sizes="(min-width: 900px) 380px, 100vw"
            formats={['avif', 'webp']}
            loading="eager"
          />
        </div>
        <div>
          <h2>19 años en buscadores. Vi cada cambio desde adentro.</h2>
          <p class="lead">Vas a trabajar directo conmigo, con datos y sin jerga.</p>
          <p>
            Empecé en buscadores en 2007, con publicidad paga, y en SEO en 2010. Desde 2015 soy co-founder de Onmarc, en
            Córdoba, donde dirijo los proyectos de buscadores. Antes fui SEO Manager en Tecnofits y Coordinador SEO en
            Vittalia.
          </p>
          <p>
            También fui docente de SEO, Google Ads y Analytics, soy diplomado en Marketing Digital (UBP) y trabajé ocho
            años en radio. De ahí me quedó el oficio de explicar claro, para que puedas decidir sin depender de las
            siglas.
          </p>
          <ol class="path">
            <li>2007</li>
            <li>2010</li>
            <li>2015</li>
            <li>hoy</li>
          </ol>
          <ul class="principles">
            <li><b>Trabajo directo conmigo.</b> No te paso a un equipo que no conocés.</li>
            <li><b>Datos con fuente.</b> Si afirmo algo, te muestro de dónde sale.</li>
            <li><b>Sin promesas de posición.</b> Te muestro lo que medimos, todos los meses.</li>
          </ul>
          <a class="text-link" href="/martin-galmarino/">Conocé mi recorrido</a>
        </div>
      </div>
    </section>

    <section class="band-white" id="recursos">
      <div class="wrap">
        <h2>Entendé qué cambió antes de decidir. Son lecturas cortas.</h2>
        <p class="lead">Llegás al diagnóstico sabiendo qué preguntar.</p>
        <div class="guides">
          {
            homeGuides.map((guide) => (
              <a class="guide" href={guide.href}>
                <span class="ico" aria-hidden="true">
                  <svg>
                    <use href={`#i-${guide.icon}`} />
                  </svg>
                </span>
                <h3>{guide.title}</h3>
                <p>
                  <b>Te llevás:</b> {guide.take}
                </p>
                <span class="guide__meta">Leer · {guide.minutes} min</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <Proof />

    {
      posts.length > 0 && (
        <section class="band-lav" id="notas">
          <div class="wrap">
            <h2>Últimas notas</h2>
            <div class="post-list">
              {posts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="band-cream" id="preguntas">
      <div class="wrap narrow">
        <h2>Lo que te estás preguntando, contestado claro</h2>
        <p class="lead">Respuestas cortas a lo que suele frenar la decisión.</p>
        <FaqList items={faqs} />
      </div>
    </section>

    <section class="finale tex-grid" id="bloque-cta-final">
      <div class="glow" aria-hidden="true"></div>
      <div class="wrap">
        <h2>En tu rubro, alguien ya es la respuesta. <em>¿Sos vos?</em></h2>
        <p class="lead">
          En hasta 5 días hábiles lo sabés: 10 preguntas reales de tu rubro, probadas en Google, ChatGPT, Gemini y
          Perplexity.
        </p>
        <div class="ctas">
          <a class="button button--primary" href="/diagnostico/">Quiero ver cómo me ve la IA</a>
        </div>
        <p class="micro"><span>Gratis y sin compromiso</span></p>
      </div>
    </section>
  </div>
</BaseLayout>
