---
import { searchTabs } from '../data/home';

const question = '¿Qué empresa de mantenimiento industrial me conviene en Córdoba?';
const links = [
  'mantenimiento-a.com.ar',
  'servicio-b.com.ar',
  'taller-c.com.ar',
  'planta-d.com.ar',
  'equipos-e.com.ar',
  'cordoba-f.com.ar',
  'industrial-g.com.ar',
  'turnos-h.com.ar',
  'repuestos-i.com.ar',
  'zona-j.com.ar',
];
---

<div class="stabs" data-search-tabs>
  <p class="stabs__ask">
    <span class="qlabel">La pregunta</span>
    «{question}»
  </p>
  <div class="tablist" role="tablist" aria-label="Dónde se busca hoy">
    {
      searchTabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          <svg aria-hidden="true">
            <use href={`#i-${tab.icon}`} />
          </svg>
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    searchTabs.map((tab, index) => (
      <div
        class="spanel"
        role="tabpanel"
        id={`panel-${tab.id}`}
        aria-labelledby={`tab-${tab.id}`}
        hidden={index !== 0}
      >
        <div class="win" aria-hidden="true">
          <div class="win-bar">
            <i />
            <i />
            <i />
            <span class="win-url">{tab.label}</span>
            <span class="ilus">Ejemplo ilustrativo</span>
          </div>
          <div class="win-body">
            {tab.kind === 'lista' && (
              <>
                <div class="hit">
                  <span>ejemplo-empresa.com.ar</span>
                  <strong>Empresa del Ejemplo — mantenimiento industrial en Córdoba</strong>
                  <em class="pin">¿Dónde estás vos?</em>
                </div>
                <div class="dim">
                  <span>otra-opcion.example</span>
                  <strong>Otras empresas del rubro</strong>
                </div>
              </>
            )}
            {tab.kind === 'resumen' && (
              <div class="sum">
                <span>Visión general creada por IA</span>
                <p>
                  <strong>Empresa A</strong> hace mantenimiento industrial en Córdoba y publica qué incluye el servicio.
                </p>
                <em class="pin">¿Dónde estás vos?</em>
              </div>
            )}
            {tab.kind === 'chat' && (
              <>
                <p class="bubble me">¿Qué empresa de mantenimiento industrial me conviene en Córdoba?</p>
                <p class="bubble ai">
                  Empresa A publica zona y alcance. ¿Querés que compare plazos?
                  <em class="pin">¿Dónde estás vos?</em>
                </p>
              </>
            )}
            {tab.kind === 'nombres' && (
              <div class="sum">
                <span>ChatGPT</span>
                <ol>
                  <li>
                    <strong>Empresa A</strong>
                  </li>
                  <li>
                    <strong>Empresa B</strong>
                  </li>
                </ol>
                <em class="pin">¿Dónde estás vos?</em>
              </div>
            )}
            {tab.kind === 'fuentes' && (
              <div class="sum">
                <span>Respuesta con fuentes</span>
                <p>
                  <strong>Empresa A</strong> detalla el servicio en su sitio.
                </p>
                <div class="src">
                  ejemplo-empresa.com.ar
                  <em class="pin">¿Dónde estás vos?</em>
                </div>
              </div>
            )}
          </div>
        </div>
        <div class="mean">
          <p>
            <b>Qué pasa ahí.</b> {tab.happens}
          </p>
          <p>
            <b>Qué significa ganar.</b> {tab.win}
          </p>
        </div>
      </div>
    ))
  }

  <div class="versus" aria-label="2015 contra hoy. Ejemplo ilustrativo.">
    <p class="ilus">Ejemplo ilustrativo</p>
    <div>
      <p class="qlabel">2015</p>
      <ol class="blue-links">
        {links.map((link) => <li>{link}</li>)}
      </ol>
    </div>
    <div>
      <p class="qlabel">Hoy</p>
      <div class="sum">
        <span>Una respuesta</span>
        <p>Nombra a Empresa A, Empresa B y, a veces, Empresa C.</p>
      </div>
    </div>
  </div>
  <p class="pew">
    Cuando aparece un resumen de IA, la gente hace clic en un resultado en el 8% de las visitas. Sin resumen, en el 15%. Datos de EE.UU.
    <a
      href="https://www.pewresearch.org/short-reads/2025/07/22/google-users-are-less-likely-to-click-on-links-when-an-ai-summary-appears-in-the-results/"
      target="_blank"
      rel="noopener noreferrer">Pew Research Center, 22/7/2025</a
    >
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-search-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    const select = (index: number, focus: boolean) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        const panel = panels[i];
        if (panel) panel.hidden = !on;
      });
      if (focus) tabs[index]?.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index, false));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        if (event.key === 'ArrowRight') next = index === last ? 0 : index + 1;
        if (event.key === 'ArrowLeft') next = index === 0 ? last : index - 1;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = last;
        if (next === null) return;
        event.preventDefault();
        select(next, true);
      });
    });
  });
</script>
