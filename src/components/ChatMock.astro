---
import { chatQuestions } from '../data/home';

interface Props {
  question?: string;
  lines?: string[];
}

const { question, lines = ['Empresa A · trabaja con pymes de la zona', 'Empresa B · tiene reseñas y precios publicados'] } = Astro.props;
const questions = question ? [question] : chatQuestions;
---

<div class="cm">
  <div class="cm-bar">
    <span class="cm-in">Preguntado en</span>
    <span class="rot-sm" data-channel aria-hidden="true">
      <svg><use href="#i-chat" data-channel-icon></use></svg>
      <span data-channel-name>ChatGPT</span>
    </span>
    <span class="visually-hidden">Preguntado en ChatGPT, Gemini, Perplexity y Google</span>
    <span class="ilus">Ejemplo ilustrativo</span>
  </div>
  <div class="cm-body">
    <div class="cm-q">
      <span class="tw" data-rotator data-q={JSON.stringify(questions)}>{questions[0]}</span><i class="caret" aria-hidden="true"></i>
    </div>
    <div class="cm-a">
      <p>Estas son algunas opciones que suelen recomendarse:</p>
      <ol>
        {lines.map((line) => <li><b>{line.split(' · ')[0]}</b>{line.includes(' · ') ? ` · ${line.split(' · ').slice(1).join(' · ')}` : ''}</li>)}
      </ol>
    </div>
    <div class="cm-you">
      <span class="dot" aria-hidden="true">3</span>
      <span>¿Y tu empresa?</span>
      <span class="dash" aria-hidden="true"></span>
    </div>
  </div>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const shot = new URLSearchParams(location.search).has('shot');
  const channels = [
    ['chat', 'ChatGPT'],
    ['orbit', 'Gemini'],
    ['book', 'Perplexity'],
    ['search', 'Google'],
  ] as const;

  document.querySelectorAll<HTMLElement>('.cm').forEach((root) => {
    const name = root.querySelector<HTMLElement>('[data-channel-name]');
    const icon = root.querySelector('use');
    const rotator = root.querySelector<HTMLElement>('[data-rotator]');
    const questions = rotator?.dataset.q ? (JSON.parse(rotator.dataset.q) as string[]) : [];

    const showChannel = (index: number) => {
      const next = channels[index % channels.length];
      if (!next || !name || !icon) return;
      name.textContent = next[1];
      icon.setAttribute('href', `#i-${next[0]}`);
    };

    showChannel(0);
    if (reduce || shot) return;

    let index = 0;
    if (rotator && questions.length > 1) {
      const type = (text: string, step = 0) => {
        rotator.textContent = text.slice(0, step);
        if (step < text.length) {
          window.setTimeout(() => type(text, step + 1), 38);
          return;
        }
        window.setTimeout(() => {
          index = (index + 1) % channels.length;
          const question = questions[index % questions.length] ?? '';
          showChannel(index);
          type(question);
        }, 2200);
      };
      type(questions[0] ?? '');
      return;
    }

    window.setInterval(() => {
      index = (index + 1) % channels.length;
      showChannel(index);
    }, 2500);
  });
</script>
