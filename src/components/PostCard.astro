---
import { Picture } from 'astro:assets';
import { categoryPath, formatDate, isoDate, postPath, type Post } from '../lib/blog';

interface Props {
  post: Post;
  level?: 2 | 3;
}

const { post, level = 2 } = Astro.props;
const Title = level === 3 ? 'h3' : 'h2';
---

<article class="post-card">
  <Picture
    src={post.data.heroImage}
    alt={post.data.heroAlt}
    formats={['avif', 'webp']}
    widths={[400, 800]}
    sizes="(min-width: 800px) 340px, 100vw"
    layout="constrained"
    loading="lazy"
  />
  <div>
    <p class="meta">
      <a href={categoryPath(post.data.category)}>{post.data.category}</a>
    </p>
    <Title>
      <a href={postPath(post.id)}>{post.data.title}</a>
    </Title>
    <p>{post.data.description}</p>
    <p class="meta">
      Firmado por {post.data.author}
      · <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
    </p>
  </div>
</article>
