---
import { checks, copyQuestions } from '../data/home';
---

<div class="check" data-checklist>
  <fieldset>
    <legend class="visually-hidden">Marcá las señales que te pasan</legend>
    <ol>
      {
        checks.map((item) => (
          <li>
            <label>
              <input type="checkbox" />
              <span>{item}</span>
            </label>
          </li>
        ))
      }
    </ol>
  </fieldset>
  <p class="check__result" data-result aria-live="polite">Marcá las que te pasan.</p>
  <div class="prompts">
    <p class="qlabel">Tres preguntas para copiar</p>
    <ul>
      {
        copyQuestions.map((question) => (
          <li>
            <p>{question}</p>
            <button type="button" data-copy={question}>
              Copiar
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const results = [
    'Vas bien. Igual conviene medirlo cada tanto, porque las respuestas cambian.',
    'Vas bien. Igual conviene medirlo cada tanto, porque las respuestas cambian.',
    'Hay lugares donde hoy te gana otro. Vale la pena ver cuáles.',
    'Hay lugares donde hoy te gana otro. Vale la pena ver cuáles.',
    'Para la IA, tu empresa casi no existe. Es el mejor momento para empezar.',
    'Para la IA, tu empresa casi no existe. Es el mejor momento para empezar.',
  ];

  document.querySelectorAll<HTMLElement>('[data-checklist]').forEach((root) => {
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const output = root.querySelector<HTMLElement>('[data-result]');
    let touched = false;

    const paint = () => {
      if (!output) return;
      const count = boxes.filter((box) => box.checked).length;
      output.textContent = touched ? (results[count] ?? results[0]) : 'Marcá las que te pasan.';
    };

    boxes.forEach((box) => {
      box.addEventListener('change', () => {
        touched = true;
        paint();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const text = button.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const area = document.createElement('textarea');
          area.value = text;
          area.setAttribute('readonly', '');
          area.style.position = 'fixed';
          area.style.left = '-999px';
          document.body.append(area);
          area.select();
          document.execCommand('copy');
          area.remove();
        }
        const previous = button.textContent;
        button.textContent = 'Copiada';
        window.setTimeout(() => {
          button.textContent = previous;
        }, 1800);
      });
    });
  });
</script>
