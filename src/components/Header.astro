---
import wordmark from '../assets/brand/wordmark.svg?url';

const path = Astro.url.pathname;

const links = [
  { href: '/servicios/', label: 'Servicios' },
  { href: '/guia/', label: 'Entender la búsqueda' },
  { href: '/blog/', label: 'Blog' },
  { href: '/martin-galmarino/', label: 'Sobre mí' },
];

function current(href: string) {
  return path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined;
}
---

<a class="skip" href="#contenido">Saltar al contenido</a>
<header class="header">
  <div class="wrap header__inner">
    <a class="brand" href="/" aria-label="Martín Galmarino, inicio">
      <img src={wordmark} alt="Martín Galmarino" width="226" height="48" />
    </a>
    <nav class="nav nav-desktop" aria-label="Principal">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current(link.href)}>
            {link.label}
          </a>
        ))
      }
      <a class="button button--primary" href="/diagnostico/">Ver cómo me ve la IA</a>
    </nav>
    <details class="menu">
      <summary class="menu__button">
        <span class="visually-hidden">Abrir menú</span>
        <span class="menu__icon" aria-hidden="true"></span>
      </summary>
      <nav class="nav" aria-label="Principal">
        {
          links.map((link) => (
            <a href={link.href} aria-current={current(link.href)}>
              {link.label}
            </a>
          ))
        }
        <a class="button button--primary" href="/diagnostico/">Ver cómo me ve la IA</a>
      </nav>
    </details>
  </div>
</header>
